# Referencia opcional: CLIpping no carga archivos .env automáticamente.
# No se necesitan claves de API ni secretos.
# Exporta la variable en zsh sólo si necesitas seleccionar la raíz del proyecto.
# Las rutas relativas de configuración se resuelven respecto a esa raíz.
# --root DIR tiene prioridad sobre CLIP_FACTORY_ROOT.
# Ejemplo, ejecutado desde clip-factory/:
# export CLIP_FACTORY_ROOT="$PWD"
